# Node environment - set to 'production' for production builds
NODE_ENV=development

# Vite base URL for asset paths (use '/' for root)
VITE_BASE_URL=/

# Optional: API endpoint if a backend is connected
VITE_API_URL=http://localhost:3000

# Optional: App version for display/tracking
VITE_APP_VERSION=1.0.0

# Optional: Feature flag - set to 'true' to enable debug panel
VITE_DEBUG_MODE=false

# Docker: port to expose the Nginx server on host
DOCKER_PORT=8080
